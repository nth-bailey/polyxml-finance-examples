<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="urn:iso:std:iso:20022:tech:xsd:pacs.008.001.10"
           targetNamespace="urn:iso:std:iso:20022:tech:xsd:pacs.008.001.10"
           elementFormDefault="qualified">

    <xs:annotation>
        <xs:documentation>
            ISO 20022 Financial Services - Financial Information eXchange
            Message Identifier: pacs.008.001.10 (Financial Institutional Customer Credit Transfer)
            Source: ISO 20022 Registration Authority (https://www.iso20022.org)
            Open standard free of intellectual property restrictions under the ISO 20022 IP Policy.
        </xs:documentation>
    </xs:annotation>

    <!-- Active Currency Code (ISO 4217) -->
    <xs:simpleType name="ActiveCurrencyCode">
        <xs:restriction base="xs:string">
            <xs:pattern value="[A-Z]{3,3}"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Charge Bearer Type -->
    <xs:simpleType name="ChargeBearerType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="DEBT"/>
            <xs:enumeration value="CRED"/>
            <xs:enumeration value="SHAR"/>
            <xs:enumeration value="SLEV"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Settlement Method -->
    <xs:simpleType name="SettlementMethodCode">
        <xs:restriction base="xs:string">
            <xs:enumeration value="INDA"/>
            <xs:enumeration value="INGA"/>
            <xs:enumeration value="CLRG"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Postal Address -->
    <xs:complexType name="PostalAddress">
        <xs:sequence>
            <xs:element name="StreetName" type="xs:string" minOccurs="0"/>
            <xs:element name="BuildingNumber" type="xs:string" minOccurs="0"/>
            <xs:element name="PostCode" type="xs:string" minOccurs="0"/>
            <xs:element name="TownName" type="xs:string"/>
            <xs:element name="Country" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Party Identification (Debtor / Creditor) -->
    <xs:complexType name="PartyIdentification">
        <xs:sequence>
            <xs:element name="Name" type="xs:string"/>
            <xs:element name="PostalAddress" type="PostalAddress" minOccurs="0"/>
            <xs:element name="CountryOfResidence" type="xs:string" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Clearing System Member Identification (Fedwire / CHAPS / RTGS Routing) -->
    <xs:complexType name="ClearingSystemMemberIdentification">
        <xs:sequence>
            <xs:element name="ClearingSystemId" type="xs:string"/>
            <xs:element name="MemberId" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Financial Institution Identification (BICFI, Routing) -->
    <xs:complexType name="FinancialInstitutionIdentification">
        <xs:sequence>
            <xs:element name="BICFI" type="xs:string" minOccurs="0"/>
            <xs:element name="ClearingSystemMemberId" type="ClearingSystemMemberIdentification" minOccurs="0"/>
            <xs:element name="Name" type="xs:string" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="BranchAndFinancialInstitutionIdentification">
        <xs:sequence>
            <xs:element name="FinInstnId" type="FinancialInstitutionIdentification"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Cash Account Identification -->
    <xs:complexType name="AccountIdentification">
        <xs:sequence>
            <xs:element name="IBAN" type="xs:string" minOccurs="0"/>
            <xs:element name="ProprietaryAccount" type="xs:string" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="CashAccount">
        <xs:sequence>
            <xs:element name="Id" type="AccountIdentification"/>
            <xs:element name="Currency" type="ActiveCurrencyCode" minOccurs="0"/>
            <xs:element name="Name" type="xs:string" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Currency and Amount -->
    <xs:complexType name="ActiveOrHistoricCurrencyAndAmount">
        <xs:sequence>
            <xs:element name="Currency" type="ActiveCurrencyCode"/>
            <xs:element name="Value" type="xs:double"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Payment Identification (InstructionId, EndToEndId, UETR) -->
    <xs:complexType name="PaymentIdentification">
        <xs:sequence>
            <xs:element name="InstructionId" type="xs:string"/>
            <xs:element name="EndToEndId" type="xs:string"/>
            <xs:element name="TransactionId" type="xs:string"/>
            <xs:element name="UETR" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Settlement Information -->
    <xs:complexType name="SettlementInstruction">
        <xs:sequence>
            <xs:element name="SettlementMethod" type="SettlementMethodCode"/>
            <xs:element name="ClearingSystem" type="xs:string" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Group Header -->
    <xs:complexType name="GroupHeader">
        <xs:sequence>
            <xs:element name="MsgId" type="xs:string"/>
            <xs:element name="CreDtTm" type="xs:dateTime"/>
            <xs:element name="NbOfTxs" type="xs:int"/>
            <xs:element name="SttlmInf" type="SettlementInstruction"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Remittance Information -->
    <xs:complexType name="RemittanceInformation">
        <xs:sequence>
            <xs:element name="Unstructured" type="xs:string" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Credit Transfer Transaction Information -->
    <xs:complexType name="CreditTransferTransactionInformation">
        <xs:sequence>
            <xs:element name="PmtId" type="PaymentIdentification"/>
            <xs:element name="IntrBkSttlmAmt" type="ActiveOrHistoricCurrencyAndAmount"/>
            <xs:element name="IntrBkSttlmDt" type="xs:date"/>
            <xs:element name="ChargeBearer" type="ChargeBearerType"/>
            <xs:element name="Dbtr" type="PartyIdentification"/>
            <xs:element name="DbtrAcct" type="CashAccount"/>
            <xs:element name="DbtrAgt" type="BranchAndFinancialInstitutionIdentification"/>
            <xs:element name="CdtrAgt" type="BranchAndFinancialInstitutionIdentification"/>
            <xs:element name="Cdtr" type="PartyIdentification"/>
            <xs:element name="CdtrAcct" type="CashAccount"/>
            <xs:element name="Purpose" type="xs:string" minOccurs="0"/>
            <xs:element name="RmtInf" type="RemittanceInformation" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Top-Level Message: FIToFICustomerCreditTransfer -->
    <xs:complexType name="FIToFICustomerCreditTransfer">
        <xs:sequence>
            <xs:element name="GrpHdr" type="GroupHeader"/>
            <xs:element name="CdtTrfTxInf" type="CreditTransferTransactionInformation" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Root Document Element -->
    <xs:element name="Document" type="FIToFICustomerCreditTransfer"/>

</xs:schema>

